{
  "name": "moon-ui",
  "version": "0.1.0",
  "description": "React component kit for game UIs. Dark, animated, zero CSS framework dependency.",
  "author": "Moon",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
